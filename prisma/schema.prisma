generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 2차 기획 주문 상태
enum OrderStatus {
  /// 매장 확인 중: 예약 확정 직후 매장에 공유됨
  PENDING_ACCEPT
  /// 제조 대기: 직원이 수락함
  ACCEPTED
  /// 제조 중
  PREPARING
  /// 준비 완료
  READY
  /// 수령 완료
  PICKED_UP
  /// 취소 확인 중: 운전자가 취소를 요청했고 매장 판단을 기다림
  CANCEL_REQUESTED
  /// 매장이 주문을 거절함
  REJECTED
  /// 취소 완료
  CANCELLED
}

enum OrderSource {
  VOICE
  SCREEN
}

enum ChannelType {
  MOCK_DT
}

enum PaymentStatus {
  AUTHORIZED
  CAPTURED
  VOIDED
  FAILED
}

enum TelemetrySource {
  NAVI
  FUSED
}

model User {
  id                 String          @id @default(uuid())
  name               String
  phone              String?
  voiceOrderEnabled  Boolean         @default(true) @map("voice_order_enabled")
  voiceLimitPerOrder Int             @default(20000) @map("voice_limit_per_order")
  voiceLimitDaily    Int             @default(50000) @map("voice_limit_daily")
  createdAt          DateTime        @default(now()) @map("created_at")
  vehicles           Vehicle[]
  paymentMethods     PaymentMethod[]
  favorites          Favorite[]
  orders             Order[]

  @@map("users")
}

model Vehicle {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  plateNumber String   @map("plate_number")
  deviceId    String   @unique @map("device_id")
  model       String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])
  orders      Order[]

  @@map("vehicles")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  provider  String
  token     String
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("payment_methods")
}

model Brand {
  id          String      @id @default(uuid())
  name        String
  channelType ChannelType @default(MOCK_DT) @map("channel_type")
  stores      Store[]
  menuItems   MenuItem[]

  @@map("brands")
}

model Store {
  id                 String               @id @default(uuid())
  brandId            String               @map("brand_id")
  name               String
  lat                Float
  lng                Float
  /// DT 차로 지오펜스: 중심점 + 반경(m)
  laneLat            Float                @map("lane_lat")
  laneLng            Float                @map("lane_lng")
  laneRadiusM        Int                  @default(40) @map("lane_radius_m")
  /// 준비 시간(초). 시작 추천 = 예상 수령 - 준비 시간
  prepSec            Int                  @default(180) @map("prep_sec")
  /// 입구 이후 시간(초). 예상 수령 = 입구 도착 예정 + 입구 이후 시간
  afterEntrySec      Int                  @default(120) @map("after_entry_sec")
  serviceSecPerCar   Int                  @default(60) @map("service_sec_per_car")
  isOpen             Boolean              @default(true) @map("is_open")
  /// 이 매장에서 품절된 메뉴
  soldOutMenuItemIds String[]             @default([]) @map("sold_out_menu_item_ids")
  brand              Brand                @relation(fields: [brandId], references: [id])
  orders             Order[]
  staff              StoreStaff[]
  dtVisits           DtVisit[]
  orderCounters      OrderNumberCounter[]

  @@map("stores")
}

model StoreStaff {
  id           String @id @default(uuid())
  storeId      String @map("store_id")
  loginId      String @unique @map("login_id")
  passwordHash String @map("password_hash")
  store        Store  @relation(fields: [storeId], references: [id])

  @@map("store_staff")
}

model MenuItem {
  id         String      @id @default(uuid())
  brandId    String      @map("brand_id")
  name       String
  price      Int
  prepSec    Int         @map("prep_sec")
  /// 수량 단위. TTS에서 "한 잔", "두 개"처럼 읽는다
  unit       String      @default("잔")
  options    Json        @default("[]")
  brand      Brand       @relation(fields: [brandId], references: [id])
  orderItems OrderItem[]

  @@map("menu_items")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  storeId   String?  @map("store_id")
  /// 음성 호출 이름. 예: "평소 그거"
  alias     String
  /// [{ menuItemId, qty, options }]
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("favorites")
}

model Order {
  id                 String       @id @default(uuid())
  userId             String       @map("user_id")
  vehicleId          String       @map("vehicle_id")
  storeId            String       @map("store_id")
  /// 매장·운전자가 함께 보는 주문번호. 예: P-021
  orderNo            String?      @map("order_no")
  status             OrderStatus
  source             OrderSource
  favoriteId         String?      @map("favorite_id")
  totalAmount        Int          @map("total_amount")
  plateNumber        String       @map("plate_number")
  externalOrderId    String?      @map("external_order_id")
  /// 예약 당시 매장 준비 시간(초)
  estPrepSec         Int          @map("est_prep_sec")
  idempotencyKey     String?      @unique @map("idempotency_key")
  /// 매장에 공유한 시각 (예약 확정 직후)
  sentAt             DateTime?    @map("sent_at")
  acceptedAt         DateTime?    @map("accepted_at")
  rejectedAt         DateTime?    @map("rejected_at")
  rejectReason       String?      @map("reject_reason")
  /// 제조 시작 시각
  preparingAt        DateTime?    @map("preparing_at")
  /// 제조를 시작할 때 계산한 예상 수령 시각. 제조 후 지연의 기준
  plannedPickupAt    DateTime?    @map("planned_pickup_at")
  laneEnteredAt      DateTime?    @map("lane_entered_at")
  readyAt            DateTime?    @map("ready_at")
  pickedUpAt         DateTime?    @map("picked_up_at")
  cancelRequestedAt  DateTime?    @map("cancel_requested_at")
  cancelRequestNote  String?      @map("cancel_request_note")
  /// 취소 요청 전 상태. 매장이 취소를 거절하면 이 상태로 돌아간다
  statusBeforeCancel OrderStatus? @map("status_before_cancel")
  cancelledAt        DateTime?    @map("cancelled_at")
  cancelReason       String?      @map("cancel_reason")
  cancelNote         String?      @map("cancel_note")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  user               User         @relation(fields: [userId], references: [id])
  vehicle            Vehicle      @relation(fields: [vehicleId], references: [id])
  store              Store        @relation(fields: [storeId], references: [id])
  items              OrderItem[]
  events             OrderEvent[]
  telemetry          Telemetry[]
  payment            Payment?
  dtVisit            DtVisit?

  @@index([storeId, status])
  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

/// 매장별·날짜별(KST) 주문번호 순번
model OrderNumberCounter {
  storeId String @map("store_id")
  /// YYYY-MM-DD (KST)
  day     String
  last    Int    @default(0)
  store   Store  @relation(fields: [storeId], references: [id])

  @@id([storeId, day])
  @@map("order_number_counters")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  name       String
  unitPrice  Int      @map("unit_price")
  qty        Int
  options    Json     @default("[]")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Telemetry {
  id         String          @id @default(uuid())
  orderId    String          @map("order_id")
  etaSec     Int?            @map("eta_sec")
  lat        Float?
  lng        Float?
  speedKmh   Float?          @map("speed_kmh")
  gear       String?
  source     TelemetrySource
  recordedAt DateTime        @map("recorded_at")
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, recordedAt])
  @@map("telemetry")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique @map("order_id")
  status      PaymentStatus
  amount      Int
  providerRef String?       @map("provider_ref")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model DtVisit {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  orderId       String    @unique @map("order_id")
  laneEnteredAt DateTime  @map("lane_entered_at")
  pickedUpAt    DateTime? @map("picked_up_at")
  waitSec       Int?      @map("wait_sec")
  store         Store     @relation(fields: [storeId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, pickedUpAt])
  @@map("dt_visits")
}
